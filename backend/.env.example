NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.example.com
# Browser origins allowed by CORS (REST + WebSocket); comma-separated for more than one,
# e.g. the deployed panel plus http://localhost:5173 while developing.
ADMIN_ORIGIN=https://admin.example.com
ENABLE_DOCS=false

DATABASE_URL=postgresql://ride:password@postgres:5432/ride
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=90d

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_DEV_BYPASS_CODE=            # set only in dev, e.g. 123456
OTP_PEPPER=change-me            # secret mixed into OTP hashes

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_ALERT_TEMPLATE_ID=         # DLT template with a {{message}} variable, for SOS alerts to admins

FCM_SERVICE_ACCOUNT_JSON_BASE64=

GOOGLE_MAPS_SERVER_KEY=         # Routes API fallback when OSRM is down (D-052)
OSRM_BASE_URL=http://osrm:5000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com

# Masked calling (D-058): none | stub | exotel. With exotel, rider and driver call each other
# through EXOTEL_CALLER_ID (your ExoPhone) and never see each other's number.
CALL_PROVIDER=none
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
# Public URL Exotel posts call outcomes to (+ a secret it must echo back as ?token=)
CALL_STATUS_CALLBACK_URL=
CALL_STATUS_SECRET=
CALL_MAX_SECONDS=600
CALL_MIN_INTERVAL_SECONDS=15
PAYMENT_CASH_FALLBACK_SECONDS=300 # driver may mark cash once a pending online payment is this old
PAYMENT_POLL_INTERVAL_SECONDS=60  # poll Razorpay for captures the webhook missed
PAYMENT_POLL_MAX_HOURS=24

S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # empty for Amazon S3
S3_REGION=auto                  # Amazon S3: the bucket's region, e.g. ap-south-1
S3_BUCKET=ride-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=             # leave empty; serve via signed URLs

SENTRY_DSN=
METRICS_TOKEN=                  # Prometheus scrape token for GET /metrics (empty = disabled)
TRACK_RETENTION_DAYS=30         # ride_tracks older than this are deleted nightly (SPEC §5)
LOG_LEVEL=info

# Seed (used by prisma/seed.ts only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_PHONE=+910000000000

# Business defaults (overridden by fare_config rows)
DEFAULT_SEARCH_RADIUS_KM=3
DEFAULT_SEARCH_RADIUS_RETRY_KM=5
OFFER_TIMEOUT_SECONDS=20
# Broadcast matching (D-055): drivers asked at the same time per round, and rounds before NO_DRIVER.
OFFER_BATCH_SIZE=5
MAX_OFFER_ROUNDS_PER_RIDE=3
MATCHING_DEADLINE_SECONDS=120
DRIVER_HEARTBEAT_TTL_SECONDS=15
HEARTBEAT_SWEEP_SECONDS=10
ARRIVAL_RADIUS_M=300             # "arrived" allowed within this distance of the pickup
FREE_CANCEL_WINDOW_SECONDS=120   # rider cancels free for this long after acceptance
NO_SHOW_WAIT_SECONDS=300         # driver may cancel with a rider fee this long after arriving
DRIVER_CANCEL_SUSPEND_AT=3       # driver cancellations per day before auto-suspension
OTP_START_MAX_ATTEMPTS=3
OTP_SMS_FALLBACK_SECONDS=60      # SMS the trip OTP if the rider app is offline this long after ARRIVED
