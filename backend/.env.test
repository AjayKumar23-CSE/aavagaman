NODE_ENV=test
API_BASE_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ride@localhost:54329/ride_test
SHADOW_DATABASE_URL=postgresql://ride@localhost:54329/ride_shadow
REDIS_URL=redis://localhost:63799/1

JWT_ACCESS_SECRET=test-access
JWT_REFRESH_SECRET=test-refresh
OTP_PEPPER=test-pepper
OTP_DEV_BYPASS_CODE=123456
LOG_LEVEL=warn
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_PHONE=+910000000000
# Presigning is offline; these only need to be well-formed.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ride-docs-test
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=testsecret
# Phase 2: fake OSRM (test/e2e/fake-osrm.ts) and short timers so e2e runs in seconds.
OSRM_BASE_URL=http://localhost:5055
OFFER_TIMEOUT_SECONDS=3
OFFER_BATCH_SIZE=2
DRIVER_HEARTBEAT_TTL_SECONDS=3
HEARTBEAT_SWEEP_SECONDS=1
MATCHING_DEADLINE_SECONDS=15
FREE_CANCEL_WINDOW_SECONDS=2
NO_SHOW_WAIT_SECONDS=2
OTP_SMS_FALLBACK_SECONDS=1
# Phase 4: fake Razorpay (test/e2e/fake-razorpay.ts)
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_WEBHOOK_SECRET=whsec_test
RAZORPAY_BASE_URL=http://localhost:5056
PAYMENT_CASH_FALLBACK_SECONDS=2
PAYMENT_POLL_INTERVAL_SECONDS=1
METRICS_TOKEN=metrics-test-token
# Phase 5: masked calling through a stub provider (no real calls)
CALL_PROVIDER=stub
EXOTEL_CALLER_ID=+911140001234
CALL_STATUS_SECRET=call-hook-secret
CALL_MIN_INTERVAL_SECONDS=5
